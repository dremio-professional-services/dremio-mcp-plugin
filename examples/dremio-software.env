# Dremio MCP settings for self-managed Dremio Software (Enterprise or Community).
# Copy to .env, fill in the placeholders, and load it before starting the agent:
#   set -a; source .env; set +a
# See docs/config.md. Never commit a filled-in copy.

# Coordinator URL with https:// and port.
DREMIOAI_DREMIO__URI=https://dremio.example.com:443

# PAT as @<path-to-token-file> (recommended) or the token value itself.
DREMIOAI_DREMIO__PAT=@~/.dremio/token

# Recommended optional settings (upstream defaults: FOR_SELF, false, false).
DREMIOAI_TOOLS__SERVER_MODE=FOR_SELF,FOR_DATA_PATTERNS
DREMIOAI_DREMIO__ENABLE_SEARCH=true

# Set to true only if MCP tools may create or change Dremio objects.
DREMIOAI_DREMIO__ALLOW_DML=false
